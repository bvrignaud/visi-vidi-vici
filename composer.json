{
  "name": "bvrignaud/visi-vidi-vici",
  "type": "project",
  "description": "Clear sea weather for freedivers and underwater fishermen.",
  "keywords": [
    "apnea",
    "sea",
    "spearfishing",
    "turbidity",
    "visibility"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "inertiajs/inertia-laravel": "^3.1",
    "laravel/framework": "^13.0",
    "laravel/jetstream": "^5.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "*",
    "laravel/wayfinder": "^0.1",
    "sentry/sentry-laravel": "^4.2.0",
    "silviolleite/laravelpwa": "^2.0",
    "simplestats-io/laravel-client": "^v5.0.0"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "*",
    "brianium/paratest": "*",
    "driftingly/rector-laravel": "^2.3",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.0",
    "laravel-lang/common": "^6.1",
    "laravel/boost": "^2.4",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.18",
    "laravel/telescope": "^5.20",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "*",
    "nunomaduro/phpinsights": "^2.7",
    "phpunit/phpunit": "^12.0",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "bun install",
      "bun run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan dev"
    ],
    "lint": [
      "pint --dirty --parallel"
    ],
    "lint:check": [
      "pint --dirty --parallel --test"
    ],
    "rector": [
      "rector"
    ],
    "ci:check": [
      "Composer\\Config::disableProcessTimeout",
      "bun run lint:check",
      "bun run format:check",
      "bun run types:check",
      "@test"
    ],
    "types:check": [
      "phpstan analyse"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@rector",
      "@lint:check",
      "@types:check",
      "@php artisan test --parallel"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan lang:update",
      "@php artisan boost:update --ansi",
      "pint --dirty"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
