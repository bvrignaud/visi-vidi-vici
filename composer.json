{
  "name": "bvrignaud/visi-vidi-vici",
  "type": "project",
  "description": "Clear sea weather for freedivers and underwater fishermen.",
  "keywords": [
    "apnea",
    "sea",
    "spearfishing",
    "turbidity",
    "visibility"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "inertiajs/inertia-laravel": "^3.1",
    "laravel/framework": "^13.0",
    "laravel/jetstream": "^5.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "*",
    "sentry/sentry-laravel": "^4.2.0",
    "silviolleite/laravelpwa": "^2.0",
    "simplestats-io/laravel-client": "^3.1",
    "tightenco/ziggy": "^2.0"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "*",
    "brianium/paratest": "*",
    "driftingly/rector-laravel": "^2.3",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.0",
    "laravel-lang/common": "^6.1",
    "laravel/boost": "^2.4",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.18",
    "laravel/telescope": "^5.20",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "*",
    "nunomaduro/phpinsights": "^2.7",
    "phpunit/phpunit": "^12.0",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan lang:update",
      "@php artisan boost:update --ansi",
      "pint --dirty"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pintd": [
      "@php ./vendor/bin/pint --dirty"
    ],
    "stan": [
      "@php ./vendor/bin/phpstan analyse"
    ],
    "clean": [
      "vendor/bin/rector",
      "@php ./vendor/bin/pint --dirty",
      "@php ./vendor/bin/phpstan analyse",
      "@php artisan test --parallel"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
